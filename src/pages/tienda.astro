---
import Base from '../layouts/Base.astro';
import Categoria from '../components/Categoria.astro';
import Perfume from '../components/Perfume.astro';
import { tisanas, chai, cosmetica, kits } from '../productos';
import { ruta, sitio, pesos } from '../site';
---
<Base titulo="Tienda" pagina="tienda/" descripcion="Tisanas, chai y especias, perfumes personalizados, cosmética botánica y kits de El Herbario. Envíos a todo el país.">
  <section class="contenedor" style="padding-block:clamp(2rem,6vw,4rem) 1rem">
    <p class="etiqueta">Tienda</p>
    <h1>Lo que crece en el jardín</h1>
    <p class="intro">Envíos a todo el país. El envío va incluido en compras desde {pesos(sitio.envioGratisDesde)}.</p>
    <nav class="subnav" aria-label="Secciones de la tienda">
      <a href="#tisanas">Tisanas</a>
      <a href="#chai">Chai y especias</a>
      <a href="#perfumes">Perfumes</a>
      <a href="#cosmetica">Cosmética botánica</a>
      <a href="#kits">Kits</a>
    </nav>
  </section>

  <section class="seccion"><div class="contenedor"><Categoria categoria={tisanas} /></div></section>
  <section class="seccion seccion--mantequilla"><div class="contenedor"><Categoria categoria={chai} /></div></section>
  <section class="seccion"><div class="contenedor"><Perfume /></div></section>
  <section class="seccion seccion--mantequilla"><div class="contenedor"><Categoria categoria={cosmetica} /></div></section>
  <section class="seccion"><div class="contenedor"><Categoria categoria={kits} /></div></section>

  <section class="seccion seccion--mantequilla">
    <div class="contenedor" style="text-align:center;max-width:40rem">
      <h2>¿Quieres regalar?</h2>
      <p class="intro" style="margin-inline:auto">Arma un jardín para alguien más y añade el mensaje de la tarjeta.</p>
      <a class="boton" href={ruta('arma-tu-jardin/')}>Arma tu jardín</a>
    </div>
  </section>
</Base>
