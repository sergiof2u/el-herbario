---
import Base from '../layouts/Base.astro';
import { sitio, instagramUrl, whatsappUrl, pesos } from '../site';
---
<Base titulo="Contacto" pagina="contacto/" descripcion="Escríbele a El Herbario por WhatsApp o Instagram. Estamos en la tienda Suma Subachoque y enviamos a todo el país.">
  <section class="seccion">
    <div class="contenedor">
      <p class="etiqueta">Contacto</p>
      <h1>Escríbenos</h1>
      <p class="intro" style="margin-bottom:2.5rem">¿Quieres hacer un pedido, regalar un jardín o crear tu perfume? Cuéntanos y te acompañamos.</p>
      <div class="contacto">
        <div class="caja">
          <h2 style="font-size:1.6rem">WhatsApp</h2>
          <p>{sitio.whatsappVisible}</p>
          <a class="boton" href={whatsappUrl('Hola, El Herbario.')} rel="noopener">Escribir por WhatsApp</a>
        </div>
        <div class="caja">
          <h2 style="font-size:1.6rem">Instagram</h2>
          <p>@{sitio.instagram}</p>
          <a class="boton boton--claro" href={instagramUrl} rel="noopener">Ver Instagram</a>
        </div>
        <div class="caja" style="background:var(--mantequilla);border:0">
          <h2 style="font-size:1.6rem">Encuéntranos</h2>
          <p style="margin:0"><em>Estamos en la tienda Suma Subachoque. Y enviamos a todo el país.</em></p>
        </div>
        <div class="caja" style="background:var(--mantequilla);border:0">
          <h2 style="font-size:1.6rem">Envíos y pagos</h2>
          <p>Tu pedido viaja con cuidado hasta ti. El envío va incluido en compras desde {pesos(sitio.envioGratisDesde)}.</p>
          <p style="margin:0"><strong>Medios de pago:</strong> {sitio.mediosDePago}.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
