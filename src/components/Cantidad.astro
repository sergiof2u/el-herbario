---
interface Props { chica?: boolean }
const { chica = false } = Astro.props;
---
<span class={chica ? 'cantidad cantidad--chica' : 'cantidad'} data-cantidad>
  <button type="button" data-menos aria-label="Quitar uno">−</button>
  <input type="number" inputmode="numeric" min="1" max="20" value="1" aria-label="Cantidad" />
  <button type="button" data-mas aria-label="Añadir uno">+</button>
</span>
